{
  "proxies": {
    "/api/vaccine-photo/*": {
      "upstream": "https://api.cloudinary.com/v1_1/zjq8kp0w/resources/image/upload",
      "method": "DELETE",
      "headers": {
        "Authorization": "${CLOUDINARY_ADMIN_AUTH}"
      },
      "rateLimit": "30/hour/ip"
    },
    "/api/vaccine-records": {
      "upstream": "https://here.now/api/v1/publishes/liminal-realm-qvmd/data/vaccine_records",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer ${ADMIN_RECORDS_KEY}"
      },
      "rateLimit": "30/hour/ip"
    },
    "/api/vaccine-records/*": {
      "upstream": "https://here.now/api/v1/publishes/liminal-realm-qvmd/data/vaccine_records",
      "method": "DELETE",
      "headers": {
        "Authorization": "Bearer ${ADMIN_RECORDS_KEY}"
      },
      "rateLimit": "30/hour/ip"
    }
  }
}