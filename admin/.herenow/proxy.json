{
  "proxies": {
    "/api/vaccine-records": {
      "upstream": "https://here.now/api/v1/publishes/liminal-realm-qvmd/data/vaccine_records",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer ${ADMIN_RECORDS_KEY}"
      },
      "rateLimit": "30/hour/ip"
    },
    "/api/vaccine-records/*": {
      "upstream": "https://here.now/api/v1/publishes/liminal-realm-qvmd/data/vaccine_records",
      "method": "DELETE",
      "headers": {
        "Authorization": "Bearer ${ADMIN_RECORDS_KEY}"
      },
      "rateLimit": "30/hour/ip"
    }
  }
}